# Started by D-Bus activation (SystemdService= in the D-Bus service file). Bound to the
# session so that a later login gets a fresh portal with that session's SPLICE_SOCKET.
[Unit]
Description=splice screen-cast portal
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.splice
ExecStart=/usr/bin/env splice-portal
